{
  "uid": "cking-loadtest",
  "title": "크킹 부하 테스트",
  "tags": [
    "cking",
    "loadtest"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "k6 실행 이름(testid)과 서버를 골라 본다. 지난 실행은 시간 범위를 그 실행에 맞춘다",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "개발 : dev,운영 : prod,부하 테스트 : loadtest",
        "current": {
          "text": "부하 테스트",
          "value": "loadtest"
        },
        "options": [
          {
            "text": "개발",
            "value": "dev",
            "selected": false
          },
          {
            "text": "운영",
            "value": "prod",
            "selected": false
          },
          {
            "text": "부하 테스트",
            "value": "loadtest",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "testid",
        "label": "k6 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "testid"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 2
      },
      {
        "name": "instance",
        "label": "앱 서버",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"cking-be\",instance=~\"${env}-cking-.*\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"cking-be\",instance=~\"${env}-cking-.*\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "k6 (부하를 보낸 쪽)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "초당 요청",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=\"$testid\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "응답 p95 (실행 누적)",
      "description": "k6가 실행 시작부터 누적해 계산한 값이다. 시간대별 응답 시간은 아래 앱 쪽 그래프로 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_http_req_duration_p95{testid=\"$testid\",name=\"entry\"})",
          "refId": "A"
        }
