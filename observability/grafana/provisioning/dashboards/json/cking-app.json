            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_pending{job=\"cking-be\",instance=~\"$instance\"}",
          "legendFormat": "연결 기다리는 요청",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections{job=\"cking-be\",instance=~\"$instance\"}",
          "legendFormat": "전체",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
