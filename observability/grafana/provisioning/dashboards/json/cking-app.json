    {
      "id": 7,
      "type": "timeseries",
      "title": "Hikari 연결",
      "description": "연결 기다리는 요청이 계속 0보다 크면 DB 연결이 병목",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{job=\"cking-be\",instance=~\"$instance\"}",
          "legendFormat": "사용 중",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_idle{job=\"cking-be\",instance=~\"$instance\"}",
          "legendFormat": "대기",
          "refId": "B"
